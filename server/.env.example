# Server environment configuration
# Copy to .env and adjust for your local setup

NODE_ENV=development
PORT=3001

# PostgreSQL + pgvector (Docker)
# docker run --name document-db \
#   -e POSTGRES_USER=postgres \
#   -e POSTGRES_PASSWORD=password \
#   -e POSTGRES_DB=document_ai \
#   -p 5432:5432 \
#   -d pgvector/pgvector:pg16
DATABASE_URL=postgresql://postgres:password@localhost:5432/document_ai?schema=public

# Logging: fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# Must match the frontend URL
CORS_ORIGIN=http://localhost:3000

# Relative to server/ working directory
UPLOAD_DIR=uploads

# Maximum upload size in megabytes
MAX_UPLOAD_SIZE_MB=20

# Google Gemini
# Get a key from https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.0-flash
# Embedding model for RAG (gemini-embedding-001; stored as 768-d Matryoshka vectors)
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# Better Auth (sessions in Postgres; base URL is the Next.js origin when proxied)
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=replace-with-openssl-rand-base64-32
