# Server environment configuration
# Copy to .env and adjust for your local setup

NODE_ENV=development
PORT=3001

# PostgreSQL connection string
# Homebrew Postgres on macOS typically uses your macOS username, not "postgres"
DATABASE_URL=postgresql://lukaskoenig@localhost:5432/document_analyzer?schema=public

# Logging: fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# Must match the frontend URL
CORS_ORIGIN=http://localhost:3000

# Relative to server/ working directory
UPLOAD_DIR=uploads

# Maximum upload size in megabytes
MAX_UPLOAD_SIZE_MB=20

# Google Gemini
# Get a key from https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.0-flash
