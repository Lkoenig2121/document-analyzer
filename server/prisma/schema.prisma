generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// A file uploaded to the document management system.
model Document {
  /// Stable primary key. UUID avoids sequential ID enumeration and works well across services.
  id String @id @default(uuid()) @db.Uuid

  /// Human-readable filename as provided by the client (e.g. "Q3 Report.pdf").
  originalName String @map("original_name") @db.VarChar(1024)

  /// Unique filename on disk/object storage (e.g. "1730000000000-482910384.pdf").
  /// Must be unique — it is the storage lookup key.
  storedName String @unique @map("stored_name") @db.VarChar(512)

  /// IANA media type used for validation, serving, and downstream AI processing.
  mimeType String @map("mime_type") @db.VarChar(255)

  /// File size in bytes. BigInt supports files larger than the 2 GB Int limit.
  fileSize BigInt @map("file_size")

  /// Immutable upload timestamp (set once at insert).
  uploadedAt DateTime @default(now()) @map("uploaded_at") @db.Timestamptz(3)

  /// Last metadata or record update. Managed automatically by Prisma.
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([uploadedAt])
  @@index([mimeType])
  @@map("documents")
}
